{
  "name": "r6legends-overlay",
  "version": "1.0.2",
  "description": "R6Legends always-on-top blueprint overlay for Rainbow Six Siege",
  "main": "main.js",
  "author": "Soomakee",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish always",
    "dist:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.r6legends.overlay",
    "productName": "R6Legends Overlay",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "updater.js",
      "minimap.html",
      "gui.html",
      "preload.js",
      "preload-minimap.js",
      "preload-gui.js",
      "icon.png",
      "node_modules/electron-updater/**",
      "node_modules/builder-util-runtime/**",
      "node_modules/fs-extra/**",
      "node_modules/js-yaml/**",
      "node_modules/lazy-val/**",
      "node_modules/semver/**",
      "node_modules/tiny-typed-emitter/**"
    ],
    "extraResources": [
      {
        "from": "../assets/Map Blueprints Overlays",
        "to": "overlays"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "Soomakee",
      "repo": "R6Champs"
    },
    "win": {
      "icon": "icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "R6Legends-Overlay-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
